# DOMAIN vacío => HTTP en puerto 80 (pruebas locales).
# DOMAIN=lazurik.midominio.com => HTTPS automático (necesario para cifrado y PWA).
{$DOMAIN::80} {
	root * /srv
	encode zstd gzip
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://hercules-cdn.com; connect-src 'self' data: blob: https://cdn.jsdelivr.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
	}
	@nocache path / /index.html /sw.js /src/*
	header @nocache Cache-Control "no-cache"
}
